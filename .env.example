# Required: free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
JARVIS_USER_NAME=Your Name
JARVIS_WAKE_WORD=jarvis
WHISPER_MODEL=small
JARVIS_MODEL=gemini-3.5-flash

# For sending email (Gmail shown). Use an App Password, NOT your normal password:
# https://myaccount.google.com/apppasswords  (needs 2-Step Verification turned on)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional microphone overrides. Run mic_test.py to find the device number.
# JARVIS_MIC_DEVICE=
# JARVIS_THRESHOLD=0.003
